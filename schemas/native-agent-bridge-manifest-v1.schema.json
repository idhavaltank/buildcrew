{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native-agent-bridge-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bridgeId", "hostId", "version", "status", "capabilities", "sourceBound", "externalSideEffects"],
  "properties": {
    "schemaVersion": { "const": "native-agent-bridge-manifest-v1" },
    "bridgeId": { "type": "string", "minLength": 1 },
    "hostId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["AVAILABLE", "UNAVAILABLE", "MISCONFIGURED", "NOT_VERIFIED"] },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "sourceBound": { "const": true },
    "externalSideEffects": { "const": "HOST_CONTROLLED" }
  }
}
