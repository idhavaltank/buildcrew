{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "installation-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "candidateId", "candidateFingerprint", "targetRootRef", "platform", "status", "live", "atomicSwitch", "oneController", "stages", "blockers", "residualRisk", "externalMutation", "sideEffects"],
  "properties": {
    "schemaVersion": { "const": "installation-receipt-v1" },
    "receiptId": { "type": "string", "minLength": 1 },
    "candidateId": { "type": "string", "minLength": 1 },
    "candidateFingerprint": { "type": "string", "minLength": 1 },
    "targetRootRef": { "type": "string", "minLength": 1 },
    "platform": { "enum": ["linux", "macos", "windows"] },
    "status": { "enum": ["INSTALLED", "ROLLED_BACK", "RETIRED", "BLOCKED", "CAPABILITY_UNAVAILABLE", "NOT_VERIFIED"] },
    "live": { "type": "boolean" },
    "atomicSwitch": { "type": "boolean" },
    "oneController": { "type": "boolean" },
    "stages": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "residualRisk": { "type": "array", "items": { "type": "string" } },
    "externalMutation": { "type": "boolean" },
    "sideEffects": { "const": [] }
  }
}
