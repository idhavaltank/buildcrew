{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-discovery-receipt-v1.schema.json",
  "title": "general context discovery receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "repository", "fingerprints", "status", "inspectedSources", "selectedSources", "gaps", "conflicts", "evidence", "persistence", "terminalStatus", "issuedAt"],
  "properties": {
    "schemaVersion": { "const": "context-discovery-receipt-v1" },
    "taskId": { "type": "string", "minLength": 1 },
    "repository": { "$ref": "project-context-map-v1.schema.json#/$defs/repository" },
    "fingerprints": { "$ref": "project-context-map-v1.schema.json#/$defs/fingerprints" },
    "status": { "enum": ["UNSEEN", "DISCOVERING", "CURRENT", "STALE", "INCOMPLETE", "CONFLICT", "UNAVAILABLE", "CORRUPT"] },
    "inspectedSources": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "kind", "contentHash"], "properties": { "path": { "$ref": "project-context-map-v1.schema.json#/$defs/relativePath" }, "kind": { "type": "string", "minLength": 1 }, "contentHash": { "type": "string", "minLength": 1 } } } },
    "selectedSources": { "type": "array", "items": { "$ref": "project-context-map-v1.schema.json#/$defs/relativePath" } },
    "gaps": { "type": "array", "items": { "$ref": "project-context-map-v1.schema.json#/$defs/gap" } },
    "conflicts": { "type": "array", "items": { "$ref": "project-context-map-v1.schema.json#/$defs/conflict" } },
    "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["operation", "result", "summary"], "properties": { "operation": { "type": "string", "minLength": 1 }, "result": { "enum": ["pass", "partial", "failed"] }, "summary": { "type": "string", "minLength": 1 } } } },
    "persistence": { "enum": ["external", "session_only", "unavailable"] },
    "terminalStatus": { "enum": ["COMPLETED", "MISSING_COVERAGE", "BLOCKED"] },
    "issuedAt": { "type": "string", "minLength": 1 },
    "expiresAt": { "type": ["string", "null"] }
  }
}
