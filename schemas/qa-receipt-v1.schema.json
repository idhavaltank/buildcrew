{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-receipt-v1.schema.json",
  "title": "Advisory QA receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "packetId", "requestId", "taskId", "sourceFingerprint", "adapter", "runtimeIdentity", "startedAt", "finishedAt", "status", "steps", "evidence", "findings", "skippedOrBlocked", "sideEffects", "terminal", "residualRisk"],
  "properties": {
    "schemaVersion": { "const": "qa-receipt-v1" },
    "receiptId": { "type": "string", "minLength": 1 },
    "packetId": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "sourceFingerprint": { "type": "string", "minLength": 8 },
    "adapter": { "enum": ["source_only", "browser", "android_emulator", "ios_simulator", "flutter", "compatibility"] },
    "runtimeIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "version", "build"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["PASS", "FAILED", "BLOCKED", "NOT_VERIFIED", "STALE", "MISSING_COVERAGE"] },
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stepId", "status", "evidenceRefs"],
        "properties": {
          "stepId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_VERIFIED", "NOT_RUN", "NOT_REQUIRED"] },
          "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidenceId", "kind", "summary", "contentHash", "ref"],
        "properties": {
          "evidenceId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["screenshot", "log", "trace", "network", "device", "source", "command", "other"] },
          "summary": { "type": "string", "minLength": 1 },
          "contentHash": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "skippedOrBlocked": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stepId", "reason"],
        "properties": {
          "stepId": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sideEffects": { "const": [] },
    "terminal": { "const": true },
    "residualRisk": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
