{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-provider-writeback-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "taskId", "sourceFingerprint", "providerId", "status", "live", "scope", "recordCount", "acknowledged", "blockers", "sideEffects", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "rag-provider-writeback-receipt-v1" },
    "receiptId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "sourceFingerprint": { "type": "string", "minLength": 1 },
    "providerId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["ACKNOWLEDGED", "REJECTED", "FAILED", "CAPABILITY_UNAVAILABLE"] },
    "live": { "type": "boolean" },
    "scope": { "type": "object" },
    "recordCount": { "const": 0 },
    "acknowledged": { "type": "boolean" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "sideEffects": { "const": [] },
    "generatedAt": { "type": "string", "minLength": 1 }
  }
}
