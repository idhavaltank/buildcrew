{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-adapter-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "adapterId", "kind", "hostId", "version", "status", "capabilities", "targetAllowlist", "evidenceKinds", "sourceBound", "externalSideEffects"],
  "properties": {
    "schemaVersion": { "const": "qa-adapter-manifest-v1" },
    "adapterId": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["browser", "android_emulator", "ios_simulator", "flutter"] },
    "hostId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["AVAILABLE", "UNAVAILABLE", "MISCONFIGURED", "BLOCKED", "NOT_VERIFIED"] },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "targetAllowlist": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "evidenceKinds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "sourceBound": { "const": true },
    "externalSideEffects": { "const": "HOST_CONTROLLED" }
  }
}
