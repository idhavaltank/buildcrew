{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-adapter-manifest-v1.schema.json",
  "title": "BuildCrew non-authoritative tool adapter manifest",
  "description": "A portable declaration of what an AI-tool host can provide to BuildCrew. It cannot route, grant authority, or claim execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "adapterId", "tool", "authority", "capabilities", "sideEffects"],
  "properties": {
    "schemaVersion": { "const": "tool-adapter-manifest-v1" },
    "adapterId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "tool": { "$ref": "#/$defs/tool" },
    "authority": { "$ref": "#/$defs/authority" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "sideEffects": { "const": [] }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolId", "displayName", "adapterVersion"],
      "properties": {
        "toolId": { "$ref": "#/$defs/slug" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "adapterVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "controller", "canRoute", "canSelectModel", "canGrantWrite",
        "canCloseLifecycle", "canCreateState", "canAccessSecrets", "canRunArbitraryCode"
      ],
      "properties": {
        "mode": { "const": "NON_AUTHORITATIVE" },
        "controller": { "const": "BuildCrew" },
        "canRoute": { "const": false },
        "canSelectModel": { "const": false },
        "canGrantWrite": { "const": false },
        "canCloseLifecycle": { "const": false },
        "canCreateState": { "const": false },
        "canAccessSecrets": { "const": false },
        "canRunArbitraryCode": { "const": false }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "status", "proof", "mode"],
      "properties": {
        "capabilityId": {
          "enum": [
            "repo_read", "repo_write", "shell", "tests", "browser", "device",
            "subagents", "memory", "external_actions", "approval", "persistent_state", "worktree"
          ]
        },
        "status": { "enum": ["AVAILABLE", "LIMITED", "UNAVAILABLE", "UNVERIFIED"] },
        "proof": { "enum": ["observed", "host_declared", "contract_fixture", "not_observed"] },
        "mode": { "enum": ["READ", "WRITE", "EXECUTE", "OBSERVE"] },
        "note": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
