{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-record-v1.schema.json",
  "title": "Provider-neutral sanitized RAG lesson",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "claim", "kind", "scope", "memoryTier", "projectId", "repository", "branchOrTree", "accessScope", "fingerprints", "status", "confidence", "canonicalKey", "contentHash", "evidence", "observedAt", "lastVerifiedAt", "reviewAt", "expiresAt", "contradictionGroup", "sensitivity"],
  "properties": {
    "schemaVersion": { "const": "rag-record-v1" },
    "id": { "type": "string", "minLength": 1 },
    "claim": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["project_fact", "user_preference", "correction", "failure_pattern", "process_proposal"] },
    "scope": { "enum": ["session", "repo", "project", "tenant", "global"] },
    "memoryTier": { "enum": ["stable_policy", "dynamic_durable", "session"] },
    "projectId": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "branchOrTree": { "type": "string", "minLength": 1 },
    "accessScope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "errorCode": { "type": "string", "minLength": 1 },
        "normalizedError": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "minLength": 1 },
        "issueKey": { "type": "string", "minLength": 1 },
        "stackHash": { "type": "string", "minLength": 1 },
        "taskType": { "type": "string", "minLength": 1 }
      }
    },
    "status": { "enum": ["candidate", "needs_review", "verified", "confirmed", "superseded", "rejected", "quarantined"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "canonicalKey": { "type": "string", "minLength": 1 },
    "contentHash": { "type": "string", "minLength": 16 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commitOrTree", "path", "symbol", "check", "sourceType"],
        "properties": {
          "repository": { "type": "string", "minLength": 1 },
          "commitOrTree": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1 },
          "check": { "type": "string", "minLength": 1 },
          "sourceType": { "enum": ["code", "test", "runtime", "user", "review"] }
        }
      }
    },
    "filesInvolved": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "businessLogic": { "type": "string", "minLength": 1 },
    "fixStrategy": { "type": "string", "minLength": 1 },
    "relatedRecords": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "tenantId": { "type": "string", "minLength": 1 },
    "embeddingModel": { "type": "string", "minLength": 1 },
    "embeddingVersion": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "lastVerifiedAt": { "type": ["string", "null"], "format": "date-time" },
    "reviewAt": { "type": ["string", "null"], "format": "date-time" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "supersedes": { "type": "string", "minLength": 1 },
    "contradictionGroup": { "type": ["string", "null"], "minLength": 1 },
    "sensitivity": { "enum": ["none", "redacted"] },
    "createdBy": { "type": "string", "minLength": 1 }
  }
}
