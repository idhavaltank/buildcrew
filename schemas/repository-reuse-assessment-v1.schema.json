{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repository-reuse-assessment-v1.schema.json",
  "title": "Repository-first reuse assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "repositoryId",
    "sourceFingerprint",
    "taskScopeFingerprint",
    "targetPaths",
    "searchTerms",
    "candidates",
    "representativeEvidence",
    "decision",
    "chosenBoundary",
    "rationale",
    "negativeSearchEvidence",
    "exceptionReason",
    "terminalStatus",
    "issuedAt",
    "expiresAt",
    "sideEffects"
  ],
  "properties": {
    "schemaVersion": { "const": "repository-reuse-assessment-v1" },
    "taskId": { "type": "string", "minLength": 1 },
    "repositoryId": { "type": "string", "minLength": 1 },
    "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "taskScopeFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "targetPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "searchTerms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "symbol", "publicBoundary", "evidence", "fit"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "symbol": { "type": ["string", "null"], "minLength": 1 },
          "publicBoundary": { "type": ["string", "null"], "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "fit": { "enum": ["compatible", "extendable", "incompatible"] }
        }
      }
    },
    "representativeEvidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "decision": { "enum": ["REUSE", "EXTEND", "NEW", "DOCUMENTED_EXCEPTION"] },
    "chosenBoundary": { "type": ["string", "null"], "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "negativeSearchEvidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "exceptionReason": { "type": ["string", "null"], "minLength": 1 },
    "terminalStatus": { "const": "COMPLETED" },
    "issuedAt": { "type": "string", "minLength": 1 },
    "expiresAt": { "type": "string", "minLength": 1 },
    "sideEffects": { "const": [] }
  }
}
