{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ae-named-reviewer-receipt-v1.schema.json",
  "title": "AE named reviewer supplemental receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "receiptId", "assignmentId", "genericAssignmentId",
    "genericAssignmentDigest", "taskReviewBindingDigest", "authorizationEnvelopeDigest",
    "taskId", "projectId", "repositoryId", "tenantId", "packetVersion", "planVersion",
    "waveId", "attempt", "role", "host", "expiresAt", "policyFingerprint",
    "sourceFingerprint", "scope", "overallDiffFingerprint", "shardFingerprint",
    "namedReviewer", "namedRoleProfileFingerprint", "capability", "requestedModel",
    "requestedReasoningEffort", "observedModel", "observedReasoningEffort",
    "hostObservationId", "hostObservationDigest", "processIdentity", "nonce", "authenticatedObservation",
    "promptStarted", "terminal", "live", "executionStatus", "coverageStatus",
    "verdict", "evidence", "blockers", "baseReviewReceiptDigest",
    "baseReviewReceipt", "startedAt", "finishedAt"
  ],
  "properties": {
    "schemaVersion": {"const": "ae-named-reviewer-receipt-v1"},
    "receiptId": {"type": "string", "minLength": 1},
    "assignmentId": {"type": "string", "minLength": 1},
    "genericAssignmentId": {"type": "string", "minLength": 1},
    "genericAssignmentDigest": {"$ref": "#/$defs/fingerprint"},
    "taskReviewBindingDigest": {"$ref": "#/$defs/fingerprint"},
    "authorizationEnvelopeDigest": {"$ref": "#/$defs/fingerprint"},
    "taskId": {"type": "string", "minLength": 1},
    "projectId": {"type": "string", "minLength": 1},
    "repositoryId": {"type": "string", "minLength": 1},
    "tenantId": {"type": ["string", "null"]},
    "packetVersion": {"type": "string", "minLength": 1},
    "planVersion": {"type": "string", "minLength": 1},
    "waveId": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "role": {"enum": ["worker", "final-audit"]},
    "host": {"type": "string", "minLength": 1},
    "expiresAt": {"type": "string", "format": "date-time"},
    "policyFingerprint": {"type": "string", "minLength": 1},
    "sourceFingerprint": {"type": "string", "minLength": 1},
    "scope": {"$ref": "#/$defs/scope"},
    "overallDiffFingerprint": {"$ref": "#/$defs/fingerprint"},
    "shardFingerprint": {"$ref": "#/$defs/fingerprint"},
    "namedReviewer": {"type": "string", "minLength": 1},
    "namedRoleProfileFingerprint": {"$ref": "#/$defs/fingerprint"},
    "capability": {"type": "string", "minLength": 1},
    "requestedModel": {"type": "string", "minLength": 1},
    "requestedReasoningEffort": {"type": "string", "minLength": 1},
    "observedModel": {"type": ["string", "null"]},
    "observedReasoningEffort": {"type": ["string", "null"]},
    "hostObservationId": {"type": ["string", "null"]},
    "hostObservationDigest": {"$ref": "#/$defs/fingerprint"},
    "processIdentity": {"type": ["string", "null"]},
    "nonce": {"type": ["string", "null"]},
    "authenticatedObservation": {"const": false},
    "promptStarted": {"type": "boolean"},
    "terminal": {"type": "boolean"},
    "live": {"const": false},
    "executionStatus": {"enum": ["completed", "failed", "timed_out", "interrupted", "crashed", "shutdown", "pre_prompt_failure", "replay_rejected"]},
    "coverageStatus": {"enum": ["PASS", "FINDINGS", "MISSING_COVERAGE", "BLOCKED"]},
    "verdict": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "baseReviewReceiptDigest": {"$ref": "#/$defs/fingerprint"},
    "baseReviewReceipt": {"type": "object"},
    "startedAt": {"type": "string", "format": "date-time"},
    "finishedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["scopeId", "paths", "authority"],
      "properties": {
        "scopeId": {"type": "string", "minLength": 1},
        "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "authority": {"enum": ["read", "write"]}
      }
    }
  }
}
