{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-adapter-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "runId", "adapterId", "kind", "status", "sourceFingerprint", "targetIdentity", "hostExecution", "stepResults", "artifactRefs", "blockers", "sideEffects"],
  "properties": {
    "schemaVersion": { "const": "qa-adapter-receipt-v1" },
    "receiptId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "adapterId": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["browser", "android_emulator", "ios_simulator", "flutter"] },
    "status": { "enum": ["PASS", "FAILED", "BLOCKED", "NOT_VERIFIED"] },
    "sourceFingerprint": { "type": "string", "minLength": 1 },
    "targetIdentity": { "type": "object" },
    "hostExecution": { "type": "object", "additionalProperties": false, "required": ["attempted", "transport", "proofLevel"], "properties": { "attempted": { "type": "boolean" }, "transport": { "enum": ["INJECTED_HOST", "NONE"] }, "proofLevel": { "enum": ["UNAVAILABLE", "HOST_BOUND"] } } },
    "stepResults": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "artifactRefs": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "sideEffects": { "const": [] }
  }
}
