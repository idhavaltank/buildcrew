{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-provider-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providerId", "hostId", "version", "status", "authState", "capabilities", "privacyModel", "sourceBound", "externalSideEffects"],
  "properties": {
    "schemaVersion": { "const": "rag-provider-manifest-v1" },
    "providerId": { "type": "string", "minLength": 1 },
    "hostId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["AVAILABLE", "UNAVAILABLE", "MISCONFIGURED", "NOT_VERIFIED"] },
    "authState": { "enum": ["AUTHENTICATED", "UNAVAILABLE", "SANDBOXED"] },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "privacyModel": { "enum": ["REDACTED", "TENANT_SCOPED", "HOST_DEFINED"] },
    "sourceBound": { "const": true },
    "externalSideEffects": { "const": "HOST_CONTROLLED" }
  }
}
