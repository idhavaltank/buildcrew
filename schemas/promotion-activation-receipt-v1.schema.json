{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "promotion-activation-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "candidateId", "candidateFingerprint", "priorSelection", "status", "live", "approvalId", "stages", "rollbackAvailable", "blockers", "residualRisk", "externalMutation", "sideEffects", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "promotion-activation-receipt-v1" },
    "receiptId": { "type": "string", "minLength": 1 },
    "candidateId": { "type": "string", "minLength": 1 },
    "candidateFingerprint": { "type": "string", "minLength": 1 },
    "priorSelection": { "type": "string", "minLength": 1 },
    "status": { "enum": ["ACTIVATED", "ROLLED_BACK", "BLOCKED", "FAILED", "CAPABILITY_UNAVAILABLE", "RETIRED"] },
    "live": { "type": "boolean" },
    "approvalId": { "type": "string", "minLength": 1 },
    "stages": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "rollbackAvailable": { "type": "boolean" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "residualRisk": { "type": "array", "items": { "type": "string" } },
    "externalMutation": { "type": "boolean" },
    "sideEffects": { "const": [] },
    "generatedAt": { "type": "string", "minLength": 1 }
  }
}
