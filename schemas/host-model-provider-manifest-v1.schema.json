{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "host-model-provider-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providerId", "hostId", "version", "status", "authState", "models", "sourceBound", "externalSideEffects"],
  "properties": {
    "schemaVersion": { "const": "host-model-provider-manifest-v1" },
    "providerId": { "type": "string", "minLength": 1 },
    "hostId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["AVAILABLE", "UNAVAILABLE", "MISCONFIGURED", "NOT_VERIFIED"] },
    "authState": { "enum": ["AUTHENTICATED", "UNAVAILABLE", "SANDBOXED"] },
    "models": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "sourceBound": { "const": true },
    "externalSideEffects": { "const": "HOST_CONTROLLED" }
  }
}
